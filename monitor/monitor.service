[Unit]
Description=Monitor de red v3
After=network-online.target
Wants=network-online.target

[Service]
User=roger1317
WorkingDirectory=/home/roger1317/monitor
EnvironmentFile=/etc/monitor-red.env
ExecStart=/usr/bin/python3 /home/roger1317/monitor/monitor_v3.py
Restart=always
RestartSec=10
Nice=10
# Sin NoNewPrivileges: con esa opción el comando ping del monitor falla
# ("Operation not permitted") y el panel marca SIN INTERNET aunque sí haya.

[Install]
WantedBy=multi-user.target
